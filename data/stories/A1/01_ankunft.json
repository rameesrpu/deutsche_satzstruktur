  "chapters": [
    {
      "id": "1.1",
      "title": "Hallo, Stuttgart!",
      "skill": "A1.nom",
      "drillTitle": "Nominativ & sein",
      "beats": [
        { "read": "Oktober. Ein Flugzeug aus Dubai fliegt über Stuttgart." },
        { "read": "Am Fenster sitzt eine junge Frau. Sie ist müde, aber sie lächelt." },
        { "speaker": "Der Pilot", "play": "Wir sind gleich da.", "tags": "S.wir V.wir X X" },
        { "play": "Sie heißt Ayisha.", "tags": "S.f V.sie S.f" },
        { "play": "Ayisha ist Ärztin.", "tags": "S.f V.sie S.f" },
        { "play": "Ihre Heimat ist Kerala.", "tags": "S.f S.f V.sie S.n" },
        { "read": "Kerala: Palmen, Meer, Regen und das beste Essen der Welt. Sagt Ayisha." },
        { "read": "Die Tür geht auf. Kalte Luft. Sehr kalte Luft." },
        { "play": "Das Wetter ist kalt.", "tags": "S.n S.n V.es X" },
        { "speaker": "Ayisha", "play": "Ich bin endlich hier!", "tags": "S.ich V.ich X X" },
        { "read": "Ihr Handy vibriert. Eine Nachricht aus Payyannur." },
        { "speaker": "Umma", "play": "Bist du schon da?", "tags": "V.du S.du X X" },
        { "read": "Am Gepäckband wartet Ayisha. Und wartet. Und wartet. Dann kommen die Koffer. Zwei. Riesig." },
        { "play": "Die Koffer sind sehr schwer.", "tags": "S.pl S.pl V.sie_pl X X" },
        { "read": "Dann der Ticketautomat. Alles ist auf Deutsch. Viele Knöpfe. Viele Zahlen." },
        { "speaker": "Ayisha", "play": "Der Automat ist kompliziert.", "tags": "S.m S.m V.er X" },
        { "read": "Hinter ihr steht ein Mann mit Kopfhörern. Er lächelt." },
        { "speaker": "Der Mann", "play": "Sind Sie neu hier?", "tags": "V.sie_pl S.Sie X X" },
        { "speaker": "Ayisha", "play": "Ja, ich bin neu.", "tags": "X S.ich V.ich X" },
        { "speaker": "Ayisha", "read": "Sorry … do you speak English?" },
        { "read": "Der Mann schüttelt den Kopf. Er drückt drei Knöpfe. Das Ticket kommt." },
        { "speaker": "Der Mann", "play": "Deutsch ist besser!", "tags": "S.n V.es X" },
        { "speaker": "Der Mann", "read": "Nur Deutsch! Hier, Ihr Ticket. Willkommen in Stuttgart!" },
        { "speaker": "Ayisha", "play": "Sie sind sehr nett!", "tags": "S.Sie V.sie_pl X X" },
        { "read": "Dann kommt die S-Bahn. Der Mann winkt. Und weg ist er. Kein Name. Nur ein Lächeln." },
        { "speaker": "Ayisha", "play": "Wer ist der Mann?", "tags": "X V.er S.m S.m" },
        { "read": "Ayisha schaut auf das Ticket. Ihr Abenteuer beginnt." }
      ],
      "drill": [
        { "play": "Ich bin Ärztin.", "tags": "S.ich V.ich S.f" },
        { "play": "Bist du müde?", "tags": "V.du S.du X" },
        { "play": "Er ist sehr nett.", "tags": "S.m V.er X X" },
        { "play": "Wir sind neu hier.", "tags": "S.wir V.wir X X" },
        { "play": "Ihr seid sehr laut!", "tags": "S.ihr V.ihr X X" },
        { "play": "Die Stadt ist schön.", "tags": "S.f S.f V.sie X" },
        { "play": "Das Ticket ist teuer.", "tags": "S.n S.n V.es X" },
        { "play": "Die Taschen sind schwer.", "tags": "S.pl S.pl V.sie_pl X" },
        { "play": "Sind Sie Frau Rahman?", "tags": "V.sie_pl S.Sie S.f S.f" }
      ]
    },
    {
      "id": "1.2",
      "title": "Die WG",
      "skill": "A1.praesens",
      "drillTitle": "Verben im Präsens",
      "beats": [
        { "read": "Eine Stunde später. Stuttgart-Süd, Möhringer Straße 14." },
        { "read": "Ein altes Haus mit einem kleinen Garten. Und im Garten: Hühner!" },
        { "speaker": "Ayisha", "play": "Hier wohne ich jetzt!", "tags": "X V.ich S.ich X" },
        { "read": "Die Tür geht auf. Eine junge Frau mit roten Haaren lacht." },
        { "speaker": "Lea", "play": "Hallo, ich heiße Lea!", "tags": "X S.ich V.ich S.f" },
        { "speaker": "Lea", "play": "Ich lerne Krankenpflege.", "tags": "S.ich V.ich O.f.akk" },
        { "speaker": "Ayisha", "play": "Ich komme aus Indien.", "tags": "S.ich V.ich P O.n.dat" },
        { "speaker": "Lea", "read": "Aus Indien? Super! Komm rein!" },
        { "speaker": "Ayisha", "play": "Wohnt ihr schon lange hier?", "tags": "V.ihr S.ihr X X X" },
        { "speaker": "Lea", "play": "Ja, wir wohnen gern hier.", "tags": "X S.wir V.wir X X" },
        { "read": "Ein Mann kommt aus der Küche. Er hat Mehl im Gesicht." },
        { "play": "Max wohnt auch hier.", "tags": "S.m V.er X X" },
        { "speaker": "Max", "play": "Ich backe Brezeln.", "tags": "S.ich V.ich O.pl.akk" },
        { "speaker": "Max", "play": "Ich arbeite sehr früh.", "tags": "S.ich V.ich X X" },
        { "speaker": "Ayisha", "read": "Wie früh?" },
        { "speaker": "Max", "read": "Drei Uhr. In der Nacht. Jeden Tag." },
        { "read": "Ayisha schaut ihn an. Drei Uhr? Das ist ja wie Nachtdienst im Krankenhaus!" },
        { "speaker": "Lea", "play": "Wir kochen heute zusammen!", "tags": "S.wir V.wir X X" },
        { "speaker": "Lea", "play": "Kochst du gern?", "tags": "V.du S.du X" },
        { "read": "Ayisha kocht sehr gut. Wirklich sehr gut. Aber nur, wenn sie will." },
        { "speaker": "Ayisha", "play": "Heute koche ich nicht.", "tags": "X V.ich S.ich X" },
        { "speaker": "Ayisha", "play": "Ich bin sehr müde.", "tags": "S.ich V.ich X X" },
        { "read": "Lea lacht. Max lacht auch. Dann machen sie Nudeln. Nur Nudeln." },
        { "play": "Lea und Max sind nett.", "tags": "S.f K S.m V.sie_pl X" },
        { "play": "Ayisha wohnt jetzt in Stuttgart.", "tags": "S.f V.sie X P O.n.dat" },
        { "read": "Am Abend schreibt sie an Umma: Alles gut! Dann schläft sie. Zwölf Stunden." }
      ],
      "drill": [
        { "play": "Ich wohne in Stuttgart.", "tags": "S.ich V.ich P O.n.dat" },
        { "play": "Du kommst aus Indien.", "tags": "S.du V.du P O.n.dat" },
        { "play": "Lea lernt Krankenpflege.", "tags": "S.f V.sie O.f.akk" },
        { "play": "Max arbeitet sehr früh.", "tags": "S.m V.er X X" },
        { "play": "Wir kochen zusammen.", "tags": "S.wir V.wir X" },
        { "play": "Ihr spielt Cricket.", "tags": "S.ihr V.ihr O.n.akk" },
        { "play": "Die Kinder spielen draußen.", "tags": "S.pl S.pl V.sie_pl X" },
        { "play": "Woher kommst du?", "tags": "X V.du S.du" }
      ]
    },
    {
      "id": "1.3",
      "title": "Mein Zimmer",
      "skill": "A1.artikel",
      "drillTitle": "der, die, das",
      "beats": [
        { "read": "Am Morgen scheint die Sonne. Ayisha schaut ihr Zimmer an." },
        { "play": "Das Zimmer ist klein.", "tags": "S.n S.n V.es X" },
        { "play": "Aber das Fenster ist groß.", "tags": "K S.n S.n V.es X" },
        { "speaker": "Ayisha", "play": "Hier ist ein Bett.", "tags": "X V.es S.n S.n" },
        { "speaker": "Ayisha", "play": "Und hier ist ein Tisch.", "tags": "K X V.er S.m S.m" },
        { "play": "Der Schrank ist sehr alt.", "tags": "S.m S.m V.er X X" },
        { "read": "Der Schrank ist riesig. Dunkles Holz. Und er riecht ein bisschen komisch." },
        { "play": "Die Lampe ist kaputt.", "tags": "S.f S.f V.sie X" },
        { "speaker": "Ayisha", "read": "Kein Problem. Ich bin Ärztin, keine Elektrikerin. Aber …" },
        { "read": "Sie dreht. Sie drückt. Klick! Licht!" },
        { "play": "Die Lampe funktioniert wieder!", "tags": "S.f S.f V.sie X" },
        { "read": "Dann geht sie in die Küche." },
        { "play": "Die Küche ist sehr chaotisch.", "tags": "S.f S.f V.sie X X" },
        { "play": "Da sind viele Tassen.", "tags": "X V.sie_pl S.pl S.pl" },
        { "play": "Die Teller sind schmutzig.", "tags": "S.pl S.pl V.sie_pl X" },
        { "speaker": "Lea", "read": "Das ist Max. Immer Max!" },
        { "speaker": "Max", "read": "Guten Morgen! Ich habe Frühstück!" },
        { "speaker": "Max", "play": "Die Brezeln sind ganz frisch!", "tags": "S.pl S.pl V.sie_pl X X" },
        { "speaker": "Ayisha", "play": "Was ist eine Brezel?", "tags": "X V.sie S.f S.f" },
        { "read": "Max hält eine Brezel hoch. Wie ein Pokal." },
        { "speaker": "Lea", "play": "Bist du hungrig?", "tags": "V.du S.du X" },
        { "read": "Ayisha probiert. Salzig. Weich. Lecker! Aber Biryani ist besser. Natürlich." },
        { "speaker": "Ayisha", "play": "Ihr seid lustig!", "tags": "S.ihr V.ihr X" },
        { "read": "Am Abend schaut Ayisha ihre Fotos vom Flughafen an. Auf einem Foto, im Hintergrund: der Mann vom Automaten. Wer ist er?" }
      ],
      "drill": [
        { "play": "Der Tisch ist neu.", "tags": "S.m S.m V.er X" },
        { "play": "Die Tür ist offen.", "tags": "S.f S.f V.sie X" },
        { "play": "Das Bett ist bequem.", "tags": "S.n S.n V.es X" },
        { "play": "Die Fenster sind groß.", "tags": "S.pl S.pl V.sie_pl X" },
        { "play": "Hier ist eine Lampe.", "tags": "X V.sie S.f S.f" },
        { "play": "Wo ist der Schlüssel?", "tags": "X V.er S.m S.m" },
        { "play": "Die Stühle sind alt.", "tags": "S.pl S.pl V.sie_pl X" },
        { "play": "Ein Zimmer ist frei.", "tags": "S.n S.n V.es X" }
      ]
    },
    {
      "id": "1.4",
      "title": "Fragen über Fragen",
      "skill": "A1.fragen",
      "drillTitle": "Fragen",
      "beats": [
        { "read": "Am Abend sitzen alle in der Küche. Lea macht Tee. Max hat Brezeln. Natürlich." },
        { "speaker": "Lea", "play": "Woher kommst du genau?", "tags": "X V.du S.du X" },
        { "speaker": "Ayisha", "play": "Ich komme aus Payyannur.", "tags": "S.ich V.ich P O.n.dat" },
        { "speaker": "Max", "play": "Wo ist das?", "tags": "X V.es S.n" },
        { "speaker": "Ayisha", "play": "Payyannur ist in Kerala.", "tags": "S.n V.es P O.n.dat" },
        { "speaker": "Ayisha", "read": "Im Süden von Indien. Am Meer. Mit Palmen, Kokosnüssen und sehr gutem Essen." },
        { "speaker": "Lea", "play": "Ist es dort warm?", "tags": "V.es S.n X X" },
        { "speaker": "Ayisha", "play": "Ja, es ist immer warm.", "tags": "X S.n V.es X X" },
        { "read": "Lea schaut aus dem Fenster. Draußen: Regen. Acht Grad." },
        { "speaker": "Max", "play": "Lernst du schon lange Deutsch?", "tags": "V.du S.du X X O.n.akk" },
        { "speaker": "Ayisha", "read": "Nein, erst drei Monate. Aber ich lerne schnell!" },
        { "speaker": "Ayisha", "play": "Was machst du, Max?", "tags": "X V.du S.du X" },
        { "speaker": "Max", "play": "Ich backe Brot und Brezeln.", "tags": "S.ich V.ich O.n.akk K O.pl.akk" },
        { "speaker": "Ayisha", "play": "Was macht ihr heute Abend?", "tags": "X V.ihr S.ihr X X" },
        { "speaker": "Lea", "play": "Wir spielen oft Karten.", "tags": "S.wir V.wir X O.pl.akk" },
        { "speaker": "Lea", "play": "Spielst du auch Karten?", "tags": "V.du S.du X O.pl.akk" },
        { "speaker": "Ayisha", "play": "Nein, ich spiele Cricket.", "tags": "X S.ich V.ich O.n.akk" },
        { "speaker": "Ayisha", "read": "Und ich bin sehr gut. Fast ein Profi!" },
        { "speaker": "Max", "play": "Ist das wahr?", "tags": "V.es S.n X" },
        { "read": "Ayisha nickt. Sehr ernst. Lea und Max schauen sich an." },
        { "read": "Dann klopft es an der Tür. Laut. Dreimal. Lea wird blass." },
        { "speaker": "Lea", "read": "Oh nein. Das ist Frau Schäfer. Die Vermieterin." }
      ],
      "drill": [
        { "play": "Wie heißt du?", "tags": "X V.du S.du" },
        { "play": "Wo wohnst du?", "tags": "X V.du S.du" },
        { "play": "Kommst du aus Indien?", "tags": "V.du S.du P O.n.dat" },
        { "play": "Was lernt Lea?", "tags": "X V.sie S.f" },
        { "play": "Wohnt Max in Stuttgart?", "tags": "V.er S.m P O.n.dat" },
        { "play": "Wie ist das Wetter?", "tags": "X V.es S.n S.n" },
        { "play": "Spielt ihr Karten?", "tags": "V.ihr S.ihr O.pl.akk" },
        { "play": "Woher kommen Sie?", "tags": "X V.sie_pl S.Sie" }
      ]
    },
    {
      "id": "1.5",
      "title": "Frau Schäfer",
      "skill": "A1.haben",
      "drillTitle": "haben & unregelmäßige Verben",
      "beats": [
        { "read": "Vor der Tür steht eine Frau. Graue Haare, eine Brille, eine Gartenschürze." },
        { "speaker": "Frau Schäfer", "play": "Grüß Gott, ich bin Frau Schäfer.", "tags": "X X S.ich V.ich S.f S.f" },
        { "read": "Sie schaut Ayisha an. Von oben nach unten. Und wieder nach oben." },
        { "speaker": "Frau Schäfer", "play": "Haben Sie die Hausordnung?", "tags": "V.sie_pl S.Sie O.f.akk O.f.akk" },
        { "speaker": "Ayisha", "play": "Nein, ich habe keine Hausordnung.", "tags": "X S.ich V.ich O.f.akk O.f.akk" },
        { "read": "Frau Schäfer gibt ihr ein Papier. Drei Seiten. Ganz klein geschrieben." },
        { "speaker": "Frau Schäfer", "play": "Hier haben wir die Kehrwoche.", "tags": "X V.wir S.wir O.f.akk O.f.akk" },
        { "speaker": "Ayisha", "play": "Was ist das?", "tags": "X V.es S.n" },
        { "speaker": "Lea", "read": "Jede Woche putzt eine Person die Treppe. Diese Woche: Max." },
        { "read": "Alle schauen Max an. Max schaut auf sein Handy." },
        { "speaker": "Max", "play": "Ich habe leider keine Zeit.", "tags": "S.ich V.ich X O.f.akk O.f.akk" },
        { "speaker": "Frau Schäfer", "play": "Sie haben nie Zeit, Herr Brenner!", "tags": "S.Sie V.sie_pl X O.f.akk X X" },
        { "read": "Dann hört Ayisha etwas aus dem Garten. Gack. Gack, gack!" },
        { "speaker": "Ayisha", "play": "Sie haben Hühner?", "tags": "S.Sie V.sie_pl O.pl.akk" },
        { "speaker": "Frau Schäfer", "play": "Ja, ich habe fünf Hühner.", "tags": "X S.ich V.ich O.pl.akk O.pl.akk" },
        { "speaker": "Frau Schäfer", "play": "Die Hühner haben Namen.", "tags": "S.pl S.pl V.sie_pl O.pl.akk" },
        { "speaker": "Frau Schäfer", "read": "Berta, Frieda, Hilde, Greta und Lotte." },
        { "speaker": "Ayisha", "play": "Ich liebe Hühner!", "tags": "S.ich V.ich O.pl.akk" },
        { "read": "Zum ersten Mal lächelt Frau Schäfer. Ein bisschen. Ganz kurz." },
        { "speaker": "Frau Schäfer", "play": "Essen Sie gern Eier?", "tags": "V.sie_pl S.Sie X O.pl.akk" },
        { "speaker": "Ayisha", "read": "Ja, sehr gern!" },
        { "play": "Ayisha nimmt sechs Eier.", "tags": "S.f V.sie O.pl.akk O.pl.akk" },
        { "read": "Frau Schäfer geht. Lea atmet aus. Ayisha schaut Max an." },
        { "speaker": "Ayisha", "play": "Liest du die Hausordnung?", "tags": "V.du S.du O.f.akk O.f.akk" },
        { "read": "Aber Max liegt schon auf dem Sofa. Augen zu." },
        { "play": "Max schläft schon wieder.", "tags": "S.m V.er X X" },
        { "read": "In der Nacht kann Ayisha nicht schlafen. Der alte Schrank knarrt. Und hinter dem Schrank … ist da etwas?" }
      ],
      "drill": [
        { "play": "Ich habe ein Zimmer.", "tags": "S.ich V.ich O.n.akk O.n.akk" },
        { "play": "Du hast Zeit.", "tags": "S.du V.du O.f.akk" },
        { "play": "Frau Schäfer hat Hühner.", "tags": "S.f S.f V.sie O.pl.akk" },
        { "play": "Wir haben eine Küche.", "tags": "S.wir V.wir O.f.akk O.f.akk" },
        { "play": "Habt ihr Brot?", "tags": "V.ihr S.ihr O.n.akk" },
        { "play": "Max isst Brezeln.", "tags": "S.m V.er O.pl.akk" },
        { "play": "Sprichst du Deutsch?", "tags": "V.du S.du O.n.akk" },
        { "play": "Ayisha liest die Hausordnung.", "tags": "S.f V.sie O.f.akk O.f.akk" }
      ]
    }
  ],
