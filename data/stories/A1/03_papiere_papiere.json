      "id": "3.1",
      "title": "Der Termin",
      "skill": "A1.zeit",
      "drillTitle": "Zahlen & Zeit",
      "beats": [
        { "read": "Montag. Ayisha braucht eine Anmeldung. Ohne Anmeldung: kein Bankkonto, kein Handyvertrag, nichts." },
        { "speaker": "Lea", "play": "Du brauchst einen Termin.", "tags": "S.du V.du O.m.akk O.m.akk" },
        { "read": "Lea öffnet die Webseite vom Bürgerbüro. Sie klickt. Und klickt. Und klickt." },
        { "speaker": "Lea", "play": "Der nächste Termin ist im Dezember!", "tags": "S.m S.m S.m V.er P O.m.dat" },
        { "speaker": "Ayisha", "play": "Das ist in acht Wochen!", "tags": "S.n V.es P O.pl.dat O.pl.dat" },
        { "read": "Max kommt in die Küche. Es ist elf Uhr. Für Max ist das Abend." },
        { "speaker": "Max", "play": "Ich kenne einen Trick.", "tags": "S.ich V.ich O.m.akk O.m.akk" },
        { "speaker": "Max", "play": "Die Webseite hat um sieben Uhr neue Termine.", "tags": "S.f S.f V.sie P O.f.akk O.f.akk O.pl.akk O.pl.akk" },
        { "read": "Dienstag. Sechs Uhr neunundfünfzig. Ayisha sitzt am Laptop. Ihr Finger wartet." },
        { "play": "Um sieben Uhr klickt sie.", "tags": "P O.f.akk O.f.akk V.sie S.f" },
        { "speaker": "Ayisha", "play": "Ich habe einen Termin!", "tags": "S.ich V.ich O.m.akk O.m.akk" },
        { "speaker": "Lea", "play": "Wann ist der Termin?", "tags": "X V.er S.m S.m" },
        { "speaker": "Ayisha", "play": "Der Termin ist am Freitag um halb neun.", "tags": "S.m S.m V.er P O.m.dat P X X" },
        { "read": "Freitag. Acht Uhr. Ayisha ist schon da. Dreißig Minuten zu früh. Sehr deutsch." },
        { "play": "Das Bürgerbüro öffnet um acht Uhr.", "tags": "S.n S.n V.es P O.f.akk O.f.akk" },
        { "read": "Im Wartezimmer sitzen zwanzig Leute. Ein Bildschirm zeigt Nummern." },
        { "speaker": "Ayisha", "play": "Ich habe die Nummer zweiundvierzig.", "tags": "S.ich V.ich O.f.akk O.f.akk X" },
        { "read": "Vierzig Minuten später: „Nummer zweiundvierzig, Zimmer drei!“" },
        { "speaker": "Die Beamtin", "read": "Guten Morgen. Ihr Pass, bitte. Und Ihr Geburtsdatum?" },
        { "speaker": "Ayisha", "play": "Mein Geburtstag ist am zwölften März.", "tags": "S.m S.m V.er P O.m.dat O.m.dat" },
        { "speaker": "Die Beamtin", "play": "Sie wohnen in der Möhringer Straße?", "tags": "S.Sie V.sie_pl P O.f.dat O.f.dat O.f.dat" },
        { "speaker": "Ayisha", "read": "Ja, Nummer vierzehn. Zweiter Stock." },
        { "read": "Tippen. Drucken. Stempeln. Fertig!" },
        { "speaker": "Ayisha", "play": "Ich bin jetzt offiziell hier!", "tags": "S.ich V.ich X X X" },
        { "speaker": "Die Beamtin", "read": "Sie sind Ärztin? Dann brauchen Sie in Deutschland eine Approbation." },
        { "read": "Approbation. Ayisha wiederholt das Wort. Es klingt lang. Es klingt schwer. Es klingt wie ein Berg." },
        { "read": "Und Ayisha liebt Berge." }
      ],
      "drill": [
        { "play": "Der Kurs beginnt um neun Uhr.", "tags": "S.m S.m V.er P O.f.akk O.f.akk" },
        { "play": "Am Montag arbeitet Lea.", "tags": "P O.m.dat V.sie S.f" },
        { "play": "Max steht um drei Uhr auf.", "tags": "S.m V.er P O.f.akk O.f.akk P" },
        { "play": "Im Oktober ist es kalt.", "tags": "P O.m.dat V.es S.n X" },
        { "play": "Wir essen um sieben Uhr.", "tags": "S.wir V.wir P O.f.akk O.f.akk" },
        { "play": "Der Termin ist am Mittwoch.", "tags": "S.m S.m V.er P O.m.dat" },
        { "play": "Ich arbeite von Montag bis Freitag.", "tags": "S.ich V.ich P O.m.dat P O.m.akk" },
        { "play": "Wie spät ist es?", "tags": "X X V.es S.n" }
      ]
    },
    {
      "id": "3.2",
      "title": "Die Bank",
      "skill": "A1.modal",
      "drillTitle": "Modalverben",
      "beats": [
        { "read": "Mit der Anmeldung geht alles schneller. Fast alles." },
        { "play": "Heute muss Ayisha viel erledigen.", "tags": "X M.sie S.f X V" },
        { "read": "Erste Station: die Bank. Ein junger Mann mit Krawatte." },
        { "speaker": "Der Bankberater", "play": "Was kann ich für Sie tun?", "tags": "X M.ich S.ich P O.Sie.akk V" },
        { "speaker": "Ayisha", "play": "Ich will ein Konto eröffnen.", "tags": "S.ich M.ich O.n.akk O.n.akk V" },
        { "speaker": "Der Bankberater", "play": "Dann müssen Sie dieses Formular ausfüllen.", "tags": "X M.sie_pl S.Sie O.n.akk O.n.akk V" },
        { "read": "Das Formular hat sechs Seiten. Ayisha seufzt." },
        { "speaker": "Ayisha", "play": "Kann ich das Formular mitnehmen?", "tags": "M.ich S.ich O.n.akk O.n.akk V" },
        { "speaker": "Der Bankberater", "play": "Nein, das dürfen Sie leider nicht.", "tags": "X O.n.akk M.sie_pl S.Sie X X" },
        { "read": "Eine Stunde später ist alles fertig. Die Bankkarte kommt per Post." },
        { "read": "Zweite Station: das Handy. Ayisha braucht eine deutsche SIM-Karte. Sie ruft Lea an." },
        { "speaker": "Lea", "play": "Du kannst die Karte online bestellen.", "tags": "S.du M.du O.f.akk O.f.akk X V" },
        { "speaker": "Ayisha", "play": "Ich will heute noch telefonieren!", "tags": "S.ich M.ich X X V" },
        { "speaker": "Ayisha", "read": "Umma wartet. Und Umma wartet nicht gern." },
        { "read": "Dritte Station: der Ticketautomat am Bahnhof. Schon wieder." },
        { "speaker": "Ayisha", "play": "Welches Ticket muss ich nehmen?", "tags": "O.n.akk O.n.akk M.ich S.ich V" },
        { "read": "Diesmal hilft ihr kein Fremder. Sie liest. Sie denkt. Sie drückt." },
        { "speaker": "Ayisha", "play": "Ich kann das allein!", "tags": "S.ich M.ich O.n.akk X" },
        { "play": "Der Automat druckt ein Ticket.", "tags": "S.m S.m V.er O.n.akk O.n.akk" },
        { "read": "In der S-Bahn kommt ein Kontrolleur. Ayisha ist ganz ruhig. Fast." },
        { "speaker": "Der Kontrolleur", "play": "Darf ich Ihr Ticket sehen?", "tags": "M.ich S.ich O.n.akk O.n.akk V" },
        { "play": "Ayisha zeigt stolz ihr Ticket.", "tags": "S.f V.sie X O.n.akk O.n.akk" },
        { "speaker": "Der Kontrolleur", "play": "Das Ticket ist richtig.", "tags": "S.n S.n V.es X" },
        { "read": "An der nächsten Haltestelle steht ein Mann am Bahnsteig. Kopfhörer. Ein bekanntes Lächeln." },
        { "read": "Ayisha springt auf. Aber die Türen schließen. Die Bahn fährt. Er ist draußen. Sie ist drinnen." },
        { "speaker": "Ayisha", "read": "Schon wieder!" }
      ],
      "drill": [
        { "play": "Ich kann gut kochen.", "tags": "S.ich M.ich X V" },
        { "play": "Du musst das Formular ausfüllen.", "tags": "S.du M.du O.n.akk O.n.akk V" },
        { "play": "Max will nicht putzen.", "tags": "S.m M.er X V" },
        { "play": "Wir dürfen hier nicht parken.", "tags": "S.wir M.wir X X V" },
        { "play": "Könnt ihr mir helfen?", "tags": "M.ihr S.ihr O.ich.dat V" },
        { "play": "Lea muss heute arbeiten.", "tags": "S.f M.sie X V" },
        { "play": "Darf ich hier sitzen?", "tags": "M.ich S.ich X V" },
        { "play": "Sie können hier ein Ticket kaufen.", "tags": "S.Sie M.sie_pl X O.n.akk O.n.akk V" }
      ]
    },
    {
      "id": "3.3",
      "title": "Die Kehrwoche",
      "skill": "A1.akk_pronomen",
      "drillTitle": "mich, dich, ihn …",
      "beats": [
        { "read": "Samstag. An der Wohnungstür hängt ein Schild: KEHRWOCHE. Darunter ein Name: Max." },
        { "speaker": "Lea", "play": "Wo ist Max?", "tags": "X V.er S.m" },
        { "speaker": "Ayisha", "play": "Ich sehe ihn nicht.", "tags": "S.ich V.ich O.m.akk X" },
        { "read": "Max ist nicht in der Küche. Nicht im Bad. Nicht im Bett." },
        { "speaker": "Lea", "play": "Frau Schäfer sucht ihn schon!", "tags": "S.f S.f V.sie O.m.akk X" },
        { "read": "Dann vibriert Leas Handy. Eine Nachricht von Max: „Bin bei meiner Oma. Sorry!“" },
        { "speaker": "Lea", "play": "Er liebt seine Oma nur samstags.", "tags": "S.m V.er O.f.akk O.f.akk X X" },
        { "read": "Lea nimmt den Besen. Ayisha nimmt den Eimer. Sie schauen die Treppe hinunter. Drei Etagen." },
        { "speaker": "Ayisha", "play": "Die Treppe ist so lang!", "tags": "S.f S.f V.sie X X" },
        { "read": "Unten geht eine Tür auf." },
        { "speaker": "Frau Schäfer", "play": "Ich sehe euch!", "tags": "S.ich V.ich O.ihr.akk" },
        { "speaker": "Frau Schäfer", "play": "Und wo ist Herr Brenner?", "tags": "K X V.er S.m S.m" },
        { "speaker": "Lea", "play": "Wir finden ihn nicht.", "tags": "S.wir V.wir O.m.akk X" },
        { "read": "Frau Schäfer schaut die Treppe an. Dann das Geländer. Dann die Ecken." },
        { "speaker": "Frau Schäfer", "play": "Die Ecke ist nicht sauber.", "tags": "S.f S.f V.sie X X" },
        { "speaker": "Ayisha", "play": "Ich putze sie sofort!", "tags": "S.ich V.ich O.f.akk X" },
        { "read": "Ayisha putzt. Wie im Krankenhaus. Steril. Perfekt. Die Treppe glänzt." },
        { "speaker": "Frau Schäfer", "play": "Sie machen das sehr gut!", "tags": "S.Sie V.sie_pl O.n.akk X X" },
        { "speaker": "Frau Schäfer", "play": "Ich lade Sie ein.", "tags": "S.ich V.ich O.Sie.akk P" },
        { "speaker": "Frau Schäfer", "read": "Morgen um drei. Zum Essen. Bei mir." },
        { "speaker": "Ayisha", "play": "Sie lädt uns ein!", "tags": "S.f V.sie O.wir.akk P" },
        { "read": "Am Abend kommt Max nach Hause. Er sieht die Treppe. Sie glänzt." },
        { "speaker": "Max", "play": "Ihr liebt mich, oder?", "tags": "S.ihr V.ihr O.ich.akk X" },
        { "speaker": "Lea", "play": "Nein, wir ignorieren dich!", "tags": "X S.wir V.wir O.du.akk" },
        { "read": "Am Sonntag kocht Frau Schäfer Linsen mit Spätzle. Ohne Würstchen. „Extra für Sie“, sagt sie zu Ayisha." },
        { "read": "Ayisha probiert. Lecker! Wirklich lecker. Aber in ihrem Herzen ruft eine Stimme: Biryani. Biryani. Biryani." }
      ],
      "drill": [
        { "play": "Ich sehe dich.", "tags": "S.ich V.ich O.du.akk" },
        { "play": "Siehst du mich?", "tags": "V.du S.du O.ich.akk" },
        { "play": "Lea ruft ihn an.", "tags": "S.f V.sie O.m.akk P" },
        { "play": "Wir besuchen euch.", "tags": "S.wir V.wir O.ihr.akk" },
        { "play": "Max findet es super.", "tags": "S.m V.er O.n.akk X" },
        { "play": "Frau Schäfer kennt uns.", "tags": "S.f S.f V.sie O.wir.akk" },
        { "play": "Ich frage sie.", "tags": "S.ich V.ich O.f.akk" },
        { "play": "Brauchst du ihn?", "tags": "V.du S.du O.m.akk" }
      ]
    }
  ],
