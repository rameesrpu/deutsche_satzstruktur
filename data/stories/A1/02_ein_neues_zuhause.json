    {
      "id": "2.1",
      "title": "Das Möbelhaus",
      "image": {"place": "moebelhaus", "alt": "Ein Möbelhaus und ein Parkplatz."},
      "skill": "A1.akk",
      "drillTitle": "Akkusativ",
      "beats": [
        { "read": "Samstag. Das Zimmer ist noch fast leer. Ayisha hat eine Liste." },
        { "speaker": "Ayisha", "play": "Ich brauche einen Tisch.", "tags": "S.ich V.ich O.m.akk O.m.akk" },
        { "speaker": "Ayisha", "play": "Ich brauche auch einen Stuhl.", "tags": "S.ich V.ich X O.m.akk O.m.akk" },
        { "speaker": "Ayisha", "play": "Und ich suche einen Spiegel.", "tags": "K S.ich V.ich O.m.akk O.m.akk" },
        { "speaker": "Ayisha", "read": "Ein Spiegel ist sehr wichtig. Mode ist wichtig!" },
        { "read": "Lea hat ein Auto. Ein sehr kleines Auto. Max kommt auch mit. Er trägt nichts. Er isst." },
        { "read": "Das Möbelhaus ist riesig. Drei Etagen. Tausend Tische." },
        { "speaker": "Lea", "play": "Siehst du den Tisch da?", "tags": "V.du S.du O.m.akk O.m.akk X" },
        { "speaker": "Ayisha", "play": "Der Tisch ist zu teuer.", "tags": "S.m S.m V.er X X" },
        { "speaker": "Ayisha", "play": "Ich nehme den Tisch hier.", "tags": "S.ich V.ich O.m.akk O.m.akk X" },
        { "read": "Max steht vor einem Stuhl. Der Stuhl ist pink. Mit Glitzer." },
        { "play": "Max findet den Stuhl super!", "tags": "S.m V.er O.m.akk O.m.akk X" },
        { "play": "Ayisha mag den Stuhl nicht.", "tags": "S.f V.sie O.m.akk O.m.akk X" },
        { "speaker": "Ayisha", "play": "Ich kaufe eine Lampe und einen Spiegel.", "tags": "S.ich V.ich O.f.akk O.f.akk K O.m.akk O.m.akk" },
        { "read": "An der Kasse schaut Lea in den Einkaufswagen. Tisch, Stuhl, Lampe, Spiegel, zwei Kissen, drei Pflanzen." },
        { "speaker": "Lea", "play": "Wir haben keinen Platz!", "tags": "S.wir V.wir O.m.akk O.m.akk" },
        { "read": "Das Auto ist voll. Max sitzt hinten, zwischen Tisch, Lampe und Pflanzen." },
        { "speaker": "Max", "play": "Ich sehe nichts!", "tags": "S.ich V.ich X" },
        { "read": "Zu Hause tragen sie alles nach oben. Der Tisch passt. Der Spiegel passt. Aber der alte Schrank steht im Weg." },
        { "speaker": "Lea", "play": "Wir schieben den Schrank!", "tags": "S.wir V.wir O.m.akk O.m.akk" },
        { "read": "Eins, zwei, drei! Der Schrank bewegt sich. Und hinter dem Schrank fällt etwas auf den Boden." },
        { "speaker": "Ayisha", "play": "Ich sehe ein Foto!", "tags": "S.ich V.ich O.n.akk O.n.akk" },
        { "read": "Ein altes Foto. Schwarz-weiß. Eine junge Frau in einer Uniform. Und sie sieht aus wie … eine Frau aus Kerala." }
      ],
      "drill": [
        { "play": "Ich brauche einen Stuhl.", "tags": "S.ich V.ich O.m.akk O.m.akk" },
        { "play": "Lea kauft einen Teppich.", "tags": "S.f V.sie O.m.akk O.m.akk" },
        { "play": "Max isst den Kuchen.", "tags": "S.m V.er O.m.akk O.m.akk" },
        { "play": "Wir suchen einen Supermarkt.", "tags": "S.wir V.wir O.m.akk O.m.akk" },
        { "play": "Hast du einen Schlüssel?", "tags": "V.du S.du O.m.akk O.m.akk" },
        { "play": "Ayisha trinkt einen Tee.", "tags": "S.f V.sie O.m.akk O.m.akk" },
        { "play": "Ich sehe den Mann.", "tags": "S.ich V.ich O.m.akk O.m.akk" },
        { "play": "Frau Schäfer hat einen Garten.", "tags": "S.f S.f V.sie O.m.akk O.m.akk" }
      ]
    },
    {
      "id": "2.2",
      "title": "Das Foto",
      "image": {"place": "zimmer", "alt": "Ayishas Zimmer."},
      "skill": "A1.negation",
      "drillTitle": "nicht & kein",
      "beats": [
        { "read": "Ayisha hebt das Foto auf. Die Frau ist jung, vielleicht zwanzig. Sie trägt eine weiße Uniform." },
        { "read": "Hinter ihr: ein großes Gebäude mit vielen Fenstern. Ein Krankenhaus?" },
        { "speaker": "Lea", "play": "Kennst du die Frau?", "tags": "V.du S.du O.f.akk O.f.akk" },
        { "speaker": "Ayisha", "play": "Nein, ich kenne die Frau nicht.", "tags": "X S.ich V.ich O.f.akk O.f.akk X" },
        { "speaker": "Ayisha", "play": "Sie ist eine Krankenschwester.", "tags": "S.f V.sie S.f S.f" },
        { "speaker": "Max", "play": "Die Frau ist nicht aus Deutschland.", "tags": "S.f S.f V.sie X P O.n.dat" },
        { "read": "Ayisha dreht das Foto um. Auf der Rückseite steht: Stuttgart, 1972. Und noch ein Satz. In einer anderen Schrift." },
        { "speaker": "Lea", "play": "Das ist kein Deutsch!", "tags": "S.n V.es S.n S.n" },
        { "speaker": "Max", "play": "Ist das Englisch?", "tags": "V.es S.n S.n" },
        { "speaker": "Ayisha", "play": "Nein, das ist auch kein Englisch.", "tags": "X S.n V.es X S.n S.n" },
        { "read": "Ayisha liest den Satz. Einmal. Zweimal. Ihre Augen werden groß." },
        { "speaker": "Ayisha", "play": "Das ist Malayalam!", "tags": "S.n V.es S.n" },
        { "speaker": "Ayisha", "play": "Die Frau kommt vielleicht aus Kerala!", "tags": "S.f S.f V.sie X P O.n.dat" },
        { "speaker": "Lea", "play": "Aber das Foto ist sehr alt.", "tags": "K S.n S.n V.es X X" },
        { "speaker": "Max", "play": "Hat das Foto keinen Namen?", "tags": "V.es S.n S.n O.m.akk O.m.akk" },
        { "speaker": "Ayisha", "play": "Nein, es hat keinen Namen.", "tags": "X S.n V.es O.m.akk O.m.akk" },
        { "speaker": "Ayisha", "read": "Nur einen Buchstaben. Ganz unten: M." },
        { "speaker": "Lea", "play": "Wir haben keine Idee.", "tags": "S.wir V.wir O.f.akk O.f.akk" },
        { "speaker": "Max", "play": "Ich finde das nicht spannend.", "tags": "S.ich V.ich O.n.akk X X" },
        { "read": "Max gähnt und geht ins Bett. Natürlich." },
        { "speaker": "Lea", "read": "Und? Was steht da? Auf Deutsch, bitte!" },
        { "read": "Ayisha schaut auf die Schrift. Ganz leise übersetzt sie: „Hier habe ich ein Zuhause.“" },
        { "read": "In dieser Nacht schläft Ayisha nicht viel. Wer ist M.?" }
      ],
      "drill": [
        { "play": "Ich habe keinen Tisch.", "tags": "S.ich V.ich O.m.akk O.m.akk" },
        { "play": "Das ist kein Problem.", "tags": "S.n V.es S.n S.n" },
        { "play": "Max putzt nicht.", "tags": "S.m V.er X" },
        { "play": "Wir haben keine Zeit.", "tags": "S.wir V.wir O.f.akk O.f.akk" },
        { "play": "Lea trinkt keinen Kaffee.", "tags": "S.f V.sie O.m.akk O.m.akk" },
        { "play": "Ich verstehe das nicht.", "tags": "S.ich V.ich O.n.akk X" },
        { "play": "Du hast keine Hühner.", "tags": "S.du V.du O.pl.akk O.pl.akk" },
        { "play": "Das Wetter ist nicht gut.", "tags": "S.n S.n V.es X X" }
      ]
    },
    {
      "id": "2.3",
      "title": "Meine Familie, deine Familie",
      "image": {"place": "wg-haus", "alt": "Das Haus der WG mit Garten."},
      "skill": "A1.possessiv",
      "drillTitle": "mein, dein, sein, ihr …",
      "beats": [
        { "read": "Sonntagmorgen. Ayisha öffnet den Kühlschrank. Drin: Brezeln. Nur Brezeln." },
        { "speaker": "Ayisha", "play": "Ist euer Kühlschrank immer so leer?", "tags": "V.er S.m S.m X X X" },
        { "speaker": "Max", "read": "Das ist nicht leer. Das ist mein Frühstück!" },
        { "read": "Dann klingelt das Handy. Ein Videoanruf aus Payyannur. Die ganze Familie ist da: Umma, Uppa und Rizwan, ihr kleiner Bruder." },
        { "speaker": "Ayisha", "play": "Das ist mein Zimmer!", "tags": "S.n V.es S.n S.n" },
        { "speaker": "Umma", "play": "Dein Zimmer ist so klein!", "tags": "S.n S.n V.es X X" },
        { "speaker": "Ayisha", "play": "Aber mein Bett ist sehr bequem.", "tags": "K S.n S.n V.es X X" },
        { "speaker": "Rizwan", "play": "Wo ist dein Cricketschläger?", "tags": "X V.er S.m S.m" },
        { "speaker": "Ayisha", "play": "Mein Schläger ist in Kerala.", "tags": "S.m S.m V.er P O.n.dat" },
        { "speaker": "Rizwan", "read": "Ha! Endlich keine Konkurrenz für mich!" },
        { "speaker": "Uppa", "play": "Wie ist deine Vermieterin?", "tags": "X V.sie S.f S.f" },
        { "speaker": "Ayisha", "read": "Streng. Sehr streng. Aber …" },
        { "speaker": "Ayisha", "play": "Ihre Hühner sind wunderbar!", "tags": "S.pl S.pl V.sie_pl X" },
        { "read": "Dann zeigt Ayisha das Foto in die Kamera. Umma liest den Satz auf der Rückseite. Sie wird still." },
        { "speaker": "Umma", "play": "Das ist nicht unsere Familie.", "tags": "S.n V.es X S.f S.f" },
        { "speaker": "Umma", "play": "Aber ihre Uniform kenne ich.", "tags": "K O.f.akk O.f.akk V.ich S.ich" },
        { "speaker": "Umma", "read": "Früher sind viele Krankenschwestern aus Kerala nach Deutschland gegangen. Sehr viele." },
        { "read": "Nach dem Anruf geht Ayisha nach unten. Frau Schäfer steht im Garten, bei den Hühnern." },
        { "speaker": "Frau Schäfer", "play": "Mein Haus ist sehr alt.", "tags": "S.n S.n V.es X X" },
        { "speaker": "Frau Schäfer", "read": "Früher hat meine Mutter hier Zimmer vermietet. An viele junge Frauen." },
        { "read": "Ayisha zeigt ihr das Foto. Frau Schäfer schaut lange. Sehr lange." },
        { "speaker": "Frau Schäfer", "play": "Ich kenne ihr Gesicht nicht.", "tags": "S.ich V.ich O.n.akk O.n.akk X" },
        { "read": "Sie gibt Ayisha das Foto zurück. Ihre Hände zittern ein bisschen." },
        { "read": "Oben wartet Lea. Ihre Augen leuchten." },
        { "speaker": "Lea", "play": "Unser Rätsel ist spannend!", "tags": "S.n S.n V.es X" },
        { "read": "Ayisha nickt. Frau Schäfer weiß etwas. Da ist sie ganz sicher." }
      ],
      "drill": [
        { "play": "Wo ist deine Tasche?", "tags": "X V.sie S.f S.f" },
        { "play": "Lea sucht ihren Schlüssel.", "tags": "S.f V.sie O.m.akk O.m.akk" },
        { "play": "Max liebt seine Brezeln.", "tags": "S.m V.er O.pl.akk O.pl.akk" },
        { "play": "Unser Haus ist alt.", "tags": "S.n S.n V.es X" },
        { "play": "Habt ihr euer Ticket?", "tags": "V.ihr S.ihr O.n.akk O.n.akk" },
        { "play": "Ihr Garten ist sehr schön!", "tags": "S.m S.m V.er X X" },
        { "play": "Ich vermisse meine Familie.", "tags": "S.ich V.ich O.f.akk O.f.akk" },
        { "play": "Mein Bruder spielt Cricket.", "tags": "S.m S.m V.er O.n.akk" }
      ]
    }
