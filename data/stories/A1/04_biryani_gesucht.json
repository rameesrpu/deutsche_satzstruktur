    {
      "id": "4.1",
      "title": "Im Restaurant",
      "image": {"place": "restaurant", "alt": "Ein indisches Restaurant."},
      "skill": "A1.moechten",
      "drillTitle": "möchten",
      "beats": [
        { "read": "Ayisha vermisst Biryani. Sehr. Lea hat eine Idee: ein indisches Restaurant in der Stadt." },
        { "read": "Das Restaurant heißt „Masala Haus“. Rote Wände, goldene Lampen, Bollywood-Musik." },
        { "read": "Ayisha summt mit. Sie kennt jedes Lied. Lea und Max schauen sie an." },
        { "speaker": "Der Kellner", "play": "Was möchten Sie trinken?", "tags": "X M.sie_pl S.Sie V" },
        { "speaker": "Lea", "play": "Ich möchte einen Mango-Lassi.", "tags": "S.ich M.ich O.m.akk O.m.akk" },
        { "speaker": "Max", "play": "Ich möchte eine Cola, bitte.", "tags": "S.ich M.ich O.f.akk O.f.akk X" },
        { "speaker": "Ayisha", "play": "Ich möchte nur Wasser.", "tags": "S.ich M.ich X O.n.akk" },
        { "speaker": "Der Kellner", "play": "Und was möchten Sie essen?", "tags": "K X M.sie_pl S.Sie V" },
        { "speaker": "Ayisha", "play": "Ich möchte das Biryani.", "tags": "S.ich M.ich O.n.akk O.n.akk" },
        { "speaker": "Der Kellner", "play": "Möchten Sie es scharf?", "tags": "M.sie_pl S.Sie O.n.akk X" },
        { "speaker": "Ayisha", "read": "Ja. Sehr scharf, bitte. Indisch scharf!" },
        { "speaker": "Max", "play": "Wir möchten auch Naan.", "tags": "S.wir M.wir X O.n.akk" },
        { "read": "Zwanzig Minuten später. Das Biryani kommt. Ayisha probiert. Sie sagt nichts." },
        { "speaker": "Lea", "play": "Wie ist das Biryani?", "tags": "X V.es S.n S.n" },
        { "speaker": "Ayisha", "play": "Es ist nicht scharf.", "tags": "S.n V.es X X" },
        { "speaker": "Ayisha", "play": "Und der Reis ist falsch.", "tags": "K S.m S.m V.er X" },
        { "speaker": "Ayisha", "read": "Vier von zehn. Sorry." },
        { "read": "Max isst alles. Seinen Teller. Leas Teller. Und Ayishas Teller." },
        { "speaker": "Max", "play": "Ich möchte noch einen Teller!", "tags": "S.ich M.ich X O.m.akk O.m.akk" },
        { "speaker": "Lea", "play": "Möchtet ihr einen Nachtisch?", "tags": "M.ihr S.ihr O.m.akk O.m.akk" },
        { "speaker": "Ayisha", "play": "Ich möchte richtiges Biryani!", "tags": "S.ich M.ich O.n.akk O.n.akk" },
        { "read": "Der Kellner hört das. Er lacht." },
        { "speaker": "Der Kellner", "play": "Dann müssen Sie selbst kochen!", "tags": "X M.sie_pl S.Sie X V" },
        { "read": "Ayisha lächelt höflich. Selbst kochen? Nur, wenn sie will. Und heute will sie nicht." },
        { "read": "Aber beim Bezahlen gibt der Kellner ihr eine Serviette. Darauf steht: „Kerala Store, Bad Cannstatt. Der beste Reis in Stuttgart.“" }
      ],
      "drill": [
        { "play": "Ich möchte einen Tee.", "tags": "S.ich M.ich O.m.akk O.m.akk" },
        { "play": "Möchtest du Wasser?", "tags": "M.du S.du O.n.akk" },
        { "play": "Lea möchte eine Pizza.", "tags": "S.f M.sie O.f.akk O.f.akk" },
        { "play": "Wir möchten zahlen.", "tags": "S.wir M.wir V" },
        { "play": "Was möchtet ihr essen?", "tags": "X M.ihr S.ihr V" },
        { "play": "Max möchte zwei Brezeln.", "tags": "S.m M.er O.pl.akk O.pl.akk" },
        { "play": "Möchten Sie einen Kaffee?", "tags": "M.sie_pl S.Sie O.m.akk O.m.akk" },
        { "play": "Ich möchte die Rechnung, bitte.", "tags": "S.ich M.ich O.f.akk O.f.akk X" }
      ]
    },
    {
      "id": "4.2",
      "title": "Der Kerala Store",
      "image": {"place": "indischer-laden", "alt": "Ein kleiner indischer Laden."},
      "skill": "A1.trennbar",
      "drillTitle": "Trennbare Verben",
      "beats": [
        { "read": "Samstag. Ayisha fährt nach Bad Cannstatt. Allein. Mit einer Mission." },
        { "play": "Ayisha kauft heute groß ein.", "tags": "S.f V.sie X X P" },
        { "read": "Der Laden ist klein. Aber er riecht wie zu Hause: Kardamom, Zimt, Kokos, Curryblätter." },
        { "speaker": "Ayisha", "play": "Hier sieht alles gut aus!", "tags": "X V.es S.n X P" },
        { "read": "Dann sieht sie ihn: den letzten Sack Biryani-Reis. Ganz oben im Regal." },
        { "read": "Sie streckt die Hand aus. Und von der anderen Seite: noch eine Hand." },
        { "read": "Ein Mann. Kopfhörer um den Hals. Ein bekanntes Lächeln. Irgendwo spielt eine Geige. (Nur in Ayishas Kopf.)" },
        { "speaker": "Ayisha", "play": "Sie sind der Mann vom Flughafen!", "tags": "S.Sie V.sie_pl S.m S.m P O.m.dat" },
        { "speaker": "Der Mann", "play": "Und Sie sind die Frau vom Automaten!", "tags": "K S.Sie V.sie_pl S.f S.f P O.m.dat" },
        { "read": "Beide lachen. Dann schauen beide auf den Reis. Der letzte Sack." },
        { "speaker": "Der Mann", "play": "Sie können den Reis mitnehmen.", "tags": "S.Sie M.sie_pl O.m.akk O.m.akk V" },
        { "speaker": "Ayisha", "play": "Nein, das sieht nicht fair aus.", "tags": "X S.n V.es X X P" },
        { "read": "Da klingelt sein Handy. Er geht ran." },
        { "speaker": "Der Mann", "read": "Haa, Umma … njan kadayil aanu …" },
        { "read": "Ayisha starrt ihn an. Diese Wörter kennt sie. Das ist ihre Sprache!" },
        { "speaker": "Ayisha", "play": "Sie sprechen Malayalam!", "tags": "S.Sie V.sie_pl O.n.akk" },
        { "speaker": "Der Mann", "read": "Ja. Aber mit Ihnen spreche ich Deutsch. Nur Deutsch!" },
        { "speaker": "Der Mann", "play": "Sie lernen so schneller.", "tags": "S.Sie V.sie_pl X X" },
        { "speaker": "Ayisha", "read": "Unglaublich. Am Flughafen … Sie haben einfach Deutsch gesprochen!" },
        { "speaker": "Der Mann", "play": "Ich heiße übrigens Faris.", "tags": "S.ich V.ich X S.m" },
        { "speaker": "Ayisha", "play": "Ich bin Ayisha.", "tags": "S.ich V.ich S.f" },
        { "speaker": "Faris", "read": "Wir können „du“ sagen, oder? Hier in Deutschland ist das normal." },
        { "speaker": "Faris", "play": "Kommst du auch aus Kerala?", "tags": "V.du S.du X P O.n.dat" },
        { "speaker": "Ayisha", "read": "Ja, aus Payyannur. Und ich bin Cricket-Profi. Fast." },
        { "speaker": "Faris", "play": "Das glaube ich nicht!", "tags": "O.n.akk V.ich S.ich X" },
        { "read": "Am Ende teilen sie den Reis. Halb und halb. Ganz fair." },
        { "play": "Der Verkäufer packt den Reis ein.", "tags": "S.m S.m V.er O.m.akk O.m.akk P" },
        { "speaker": "Faris", "read": "Morgen spielen wir Cricket im Park. Zwanzig Leute aus Kerala. Alle sind willkommen!" },
        { "speaker": "Faris", "play": "Kommst du am Sonntag mit?", "tags": "V.du S.du P O.m.dat P" },
        { "speaker": "Ayisha", "play": "Ich komme gern mit!", "tags": "S.ich V.ich X P" },
        { "speaker": "Ayisha", "read": "Und ich bringe Lea und Max mit." },
        { "read": "Erst in der Straßenbahn merkt sie es: Sie hat seine Nummer nicht. Er hat ihre auch nicht. Nur einen halben Sack Reis." }
      ],
      "drill": [
        { "play": "Ich kaufe heute ein.", "tags": "S.ich V.ich X P" },
        { "play": "Lea ruft ihre Mutter an.", "tags": "S.f V.sie O.f.akk O.f.akk P" },
        { "play": "Max steht sehr früh auf.", "tags": "S.m V.er X X P" },
        { "play": "Wann kommst du an?", "tags": "X V.du S.du P" },
        { "play": "Wir kommen gern mit.", "tags": "S.wir V.wir X P" },
        { "play": "Der Zug fährt um acht Uhr ab.", "tags": "S.m S.m V.er P O.f.akk O.f.akk P" },
        { "play": "Ihr seht müde aus.", "tags": "S.ihr V.ihr X P" },
        { "play": "Ayisha räumt ihr Zimmer auf.", "tags": "S.f V.sie O.n.akk O.n.akk P" }
      ]
    },
    {
      "id": "4.3",
      "title": "Cricket im Park",
      "image": {"place": "park", "alt": "Ein Park in Stuttgart."},
      "skill": "A1.konnektoren",
      "drillTitle": "und, aber, oder, denn",
      "beats": [
        { "read": "Sonntag. Der Rosensteinpark. Die Sonne scheint, aber es ist kalt. Zehn Grad." },
        { "read": "Zwanzig Leute aus Kerala, drei Taschen mit Snacks, eine Thermoskanne Chai und ein Cricketschläger." },
        { "speaker": "Ayisha", "play": "Der Park ist groß, und die Leute sind nett.", "tags": "S.m S.m V.er X K / S.pl S.pl V.sie_pl X" },
        { "read": "Lea und Max sind auch da. Max sieht Faris und bleibt stehen." },
        { "speaker": "Max", "read": "Moment. Du bist der Mann mit den zehn Brezeln! Jeden Montag!" },
        { "speaker": "Faris", "read": "Schuldig." },
        { "speaker": "Faris", "play": "Spielst du Cricket, oder schaust du nur zu?", "tags": "V.du S.du O.n.akk K / V.du S.du X P" },
        { "speaker": "Ayisha", "play": "Ich spiele, denn ich bin sehr gut.", "tags": "S.ich V.ich K / S.ich V.ich X X" },
        { "speaker": "Faris", "play": "Das sagst du, aber ich glaube es nicht.", "tags": "O.n.akk V.du S.du K / S.ich V.ich O.n.akk X" },
        { "speaker": "Max", "play": "Ich spiele nicht, denn ich esse.", "tags": "S.ich V.ich X K / S.ich V.ich" },
        { "play": "Lea und Max schauen zu.", "tags": "S.f K S.m V.sie_pl P" },
        { "read": "Ayisha nimmt den Ball. Sie läuft an. Sie wirft." },
        { "speaker": "Faris", "play": "Der Ball ist schnell, aber ich treffe ihn!", "tags": "S.m S.m V.er X K / S.ich V.ich O.m.akk" },
        { "read": "Er trifft ihn nicht. Das Wicket fällt um. Alle schreien." },
        { "speaker": "Max", "play": "Ayisha ist ein Profi, und Faris ist raus!", "tags": "S.f V.sie S.m S.m K / S.m V.er X" },
        { "read": "Faris schaut auf das Wicket. Dann auf Ayisha. Dann wieder auf das Wicket." },
        { "speaker": "Faris", "play": "Du hast Glück, oder?", "tags": "S.du V.du O.n.akk X" },
        { "speaker": "Ayisha", "play": "Nein, ich habe Talent, und du hast keine Chance!", "tags": "X S.ich V.ich O.n.akk K / S.du V.du O.f.akk O.f.akk" },
        { "read": "Lea flüstert zu Max: „Er schaut sie die ganze Zeit an.“ Max isst eine Brezel. „Ich weiß.“" },
        { "read": "Nach dem Spiel gibt es Chai und Snacks. Eine Tante hat Pazhampori dabei: Bananen, frittiert. Wie zu Hause." },
        { "speaker": "Ayisha", "play": "Der Chai ist heiß, und das Pazhampori ist perfekt.", "tags": "S.m S.m V.er X K / S.n S.n V.es X" },
        { "speaker": "Faris", "play": "Möchtest du Chai oder Wasser?", "tags": "M.du S.du O.m.akk K O.n.akk" },
        { "speaker": "Ayisha", "play": "Ich nehme Chai, aber nur einen.", "tags": "S.ich V.ich O.m.akk K X O.m.akk" },
        { "read": "Am Ende fragt die Tante laut: „Wer ist in der WhatsApp-Gruppe?“ Alle geben ihre Nummern. Auch Ayisha. Auch Faris." },
        { "speaker": "Faris", "play": "Hier ist meine Nummer, für das nächste Spiel.", "tags": "X V.sie S.f S.f P O.n.akk O.n.akk O.n.akk" },
        { "speaker": "Max", "read": "Für das Spiel. Natürlich." },
        { "read": "Zu Hause schaut Ayisha auf ihr Handy. Eine Nachricht: „Revanche nächsten Sonntag? Nur Deutsch! 😄 Faris“" },
        { "read": "Ayisha lächelt. Und dann: Hatschi! Einmal. Zweimal. Dreimal." }
      ],
      "drill": [
        { "play": "Ich koche, und du spülst.", "tags": "S.ich V.ich K / S.du V.du" },
        { "play": "Lea ist müde, aber sie arbeitet.", "tags": "S.f V.sie X K / S.f V.sie" },
        { "play": "Trinkst du Tee oder Kaffee?", "tags": "V.du S.du O.m.akk K O.m.akk" },
        { "play": "Max isst viel, denn er hat Hunger.", "tags": "S.m V.er X K / S.m V.er O.m.akk" },
        { "play": "Wir spielen Cricket, und ihr schaut zu.", "tags": "S.wir V.wir O.n.akk K / S.ihr V.ihr P" },
        { "play": "Ayisha kocht gut, aber nicht heute.", "tags": "S.f V.sie X K X X" },
        { "play": "Ich bleibe zu Hause, denn ich bin krank.", "tags": "S.ich V.ich P O.n.dat K / S.ich V.ich X" },
        { "play": "Kommst du heute oder morgen?", "tags": "V.du S.du X K X" }
      ]
    }
