  "chapters": [
    {
      "id": "5.1",
      "title": "Gute Besserung",
      "image": {"place": "zimmer", "alt": "Ayishas Zimmer."},
      "skill": "A1.imperativ",
      "drillTitle": "Imperativ",
      "beats": [
        { "read": "Montag. Ayisha hat Fieber. Und Halsschmerzen. Und fast keine Stimme." },
        { "speaker": "Lea", "play": "Bleib heute im Bett!", "tags": "V X P O.n.dat" },
        { "speaker": "Lea", "play": "Trink viel Tee!", "tags": "V O.m.akk O.m.akk" },
        { "speaker": "Ayisha", "read": "Lea. Ich bin Ärztin." },
        { "speaker": "Lea", "play": "Dann sei eine gute Patientin!", "tags": "X V S.f S.f S.f" },
        { "read": "Ayisha rollt mit den Augen. Sie mag keine Befehle. Aber sie bleibt im Bett." },
        { "read": "Max kommt mit einer Tüte von der Bäckerei." },
        { "speaker": "Max", "play": "Iss eine Brezel!", "tags": "V O.f.akk O.f.akk" },
        { "speaker": "Ayisha", "play": "Bring mir lieber Suppe.", "tags": "V O.ich.dat X O.f.akk" },
        { "read": "Dann klopft es. Frau Schäfer. Mit einer Thermoskanne." },
        { "speaker": "Frau Schäfer", "play": "Trinken Sie diesen Tee!", "tags": "V S.Sie O.m.akk O.m.akk" },
        { "speaker": "Frau Schäfer", "read": "Kamillentee. Das Rezept ist von meiner Oma. Hundert Jahre alt." },
        { "speaker": "Frau Schäfer", "play": "Und machen Sie das Fenster zu!", "tags": "K V S.Sie O.n.akk O.n.akk P" },
        { "read": "Ayishas Handy vibriert. Die Cricket-Gruppe. Die Tante schreibt: „Wo ist unsere Ayisha?“ Lea antwortet: „Krank!“" },
        { "read": "Dann schreiben alle. Zwanzig Nachrichten. Ingwer! Kurkuma! Pfeffer-Rasam! Und eine Nachricht von Faris:" },
        { "speaker": "Faris", "play": "Geh bitte zum Arzt!", "tags": "V X P O.m.dat" },
        { "speaker": "Faris", "read": "Auch Ärztinnen brauchen Ärzte. Und das Team braucht seinen Profi. 😄" },
        { "speaker": "Ayisha", "play": "Sag mir das nicht!", "tags": "V O.ich.dat O.n.akk X" },
        { "read": "Aber sie lächelt. Und sie sucht eine Hausärztin in der Nähe." },
        { "speaker": "Lea", "play": "Ruf Dr. Kühn an!", "tags": "V O.f.akk O.f.akk P" },
        { "speaker": "Lea", "play": "Sie ist sehr nett.", "tags": "S.f V.sie X X" },
        { "read": "Ayisha ruft an. Die Frau am Telefon spricht schnell. Sehr schnell. Mit viel Schwäbisch." },
        { "speaker": "Ayisha", "play": "Sprechen Sie bitte langsam!", "tags": "V S.Sie X X" },
        { "speaker": "Die Arzthelferin", "play": "Kommen Sie morgen um neun!", "tags": "V S.Sie X P X" },
        { "read": "Morgen um neun. Beim Arzt. Zum ersten Mal ist Ayisha auf der anderen Seite." }
      ],
      "drill": [
        { "play": "Iss den Apfel!", "tags": "V O.m.akk O.m.akk" },
        { "play": "Trink Wasser!", "tags": "V O.n.akk" },
        { "play": "Mach das Fenster auf!", "tags": "V O.n.akk O.n.akk P" },
        { "play": "Ruf mich an!", "tags": "V O.ich.akk P" },
        { "play": "Nehmen Sie Platz!", "tags": "V S.Sie O.m.akk" },
        { "play": "Hilf mir bitte!", "tags": "V O.ich.dat X" },
        { "play": "Warten Sie hier!", "tags": "V S.Sie X" },
        { "play": "Lies den Text!", "tags": "V O.m.akk O.m.akk" }
      ]
    },
    {
      "id": "5.2",
      "title": "In der Praxis",
      "image": {"place": "praxis", "alt": "Das Wartezimmer in der Praxis."},
      "skill": "A1.dativ_praep",
      "drillTitle": "mit, bei, von, zu …",
      "beats": [
        { "read": "Dienstag, neun Uhr. Die Praxis von Dr. Kühn ist hell und freundlich." },
        { "play": "Ayisha fährt mit der U-Bahn zur Praxis.", "tags": "S.f V.sie P O.f.dat O.f.dat P O.f.dat" },
        { "speaker": "Die Arzthelferin", "play": "Sie sind bei Dr. Kühn?", "tags": "S.Sie V.sie_pl P O.f.dat O.f.dat" },
        { "read": "Im Wartezimmer sitzen eine Mutter mit einem Baby und ein alter Mann mit einer Zeitung." },
        { "play": "Die Mutter spielt mit dem Baby.", "tags": "S.f S.f V.sie P O.n.dat O.n.dat" },
        { "read": "Ayisha beobachtet das Baby. Rote Wangen, kein Fieber, gute Laune. Sie ist eben Ärztin. Auch im Wartezimmer." },
        { "read": "„Frau Rahman, bitte!“" },
        { "speaker": "Dr. Kühn", "play": "Was fehlt Ihnen?", "tags": "X V.es O.Sie.dat" },
        { "speaker": "Ayisha", "play": "Ich habe seit Sonntag Fieber.", "tags": "S.ich V.ich P O.m.dat O.n.akk" },
        { "speaker": "Dr. Kühn", "play": "Sie kommen aus Indien, oder?", "tags": "S.Sie V.sie_pl P O.n.dat X" },
        { "speaker": "Ayisha", "play": "Ich bin Ärztin aus Kerala.", "tags": "S.ich V.ich S.f P O.n.dat" },
        { "read": "Dr. Kühn lächelt. Sie untersucht Ayisha. Hals, Ohren, Lunge." },
        { "speaker": "Dr. Kühn", "read": "Eine Erkältung. Nichts Schlimmes. Viel trinken, viel schlafen." },
        { "speaker": "Ayisha", "play": "Das sage ich meinen Patienten auch!", "tags": "O.n.akk V.ich S.ich O.pl.dat O.pl.dat X" },
        { "read": "Beide lachen. Dann fällt etwas aus Ayishas Tasche. Das Foto!" },
        { "read": "Dr. Kühn hebt es auf. Sie schaut. Dann setzt sie ihre Brille auf." },
        { "speaker": "Dr. Kühn", "play": "Das Gebäude kenne ich!", "tags": "O.n.akk O.n.akk V.ich S.ich" },
        { "speaker": "Dr. Kühn", "play": "Das ist das alte St.-Lukas-Krankenhaus.", "tags": "S.n V.es S.n S.n S.n" },
        { "speaker": "Dr. Kühn", "play": "Ich kenne es aus meiner Studienzeit.", "tags": "S.ich V.ich O.n.akk P O.f.dat O.f.dat" },
        { "speaker": "Dr. Kühn", "read": "Das Krankenhaus ist schon lange zu. Seit 1998. Heute sind dort Wohnungen." },
        { "speaker": "Ayisha", "play": "Die Frau kommt aus Kerala, wie ich.", "tags": "S.f S.f V.sie P O.n.dat X S.ich" },
        { "speaker": "Dr. Kühn", "read": "Viele Krankenschwestern aus Indien haben damals bei uns gearbeitet. Ich habe von ihnen viel gelernt." },
        { "speaker": "Dr. Kühn", "play": "Fragen Sie beim Stadtarchiv!", "tags": "V S.Sie P O.n.dat" },
        { "read": "Auf dem Heimweg: die Apotheke. Ayisha kauft Halsbonbons. Und Schokolade. Medizinisch notwendig." },
        { "play": "Ayisha geht mit Schokolade nach Hause.", "tags": "S.f V.sie P O.f.dat P O.n.dat" },
        { "read": "Zu Hause schreibt sie in die Cricket-Gruppe: „Nur eine Erkältung!“ Faris antwortet sofort: „Alhamdulillah! Am Samstag fahren wir auf die Alb. Alle kommen mit. Du auch?“" }
      ],
      "drill": [
        { "play": "Ich fahre mit dem Bus.", "tags": "S.ich V.ich P O.m.dat O.m.dat" },
        { "play": "Lea arbeitet bei einem Arzt.", "tags": "S.f V.sie P O.m.dat O.m.dat" },
        { "play": "Max kommt aus der Bäckerei.", "tags": "S.m V.er P O.f.dat O.f.dat" },
        { "play": "Wir gehen zum Supermarkt.", "tags": "S.wir V.wir P O.m.dat" },
        { "play": "Fährst du nach Hause?", "tags": "V.du S.du P O.n.dat" },
        { "play": "Das Paket ist von meiner Mutter.", "tags": "S.n S.n V.es P O.f.dat O.f.dat" },
        { "play": "Kannst du mir helfen?", "tags": "M.du S.du O.ich.dat V" },
        { "play": "Ich gebe dir den Schlüssel.", "tags": "S.ich V.ich O.du.dat O.m.akk O.m.akk" }
      ]
    },
    {
      "id": "5.3",
      "title": "Ein Ausflug",
      "image": {"place": "alb", "alt": "Die Schwäbische Alb."},
      "skill": "A1.perfekt",
      "drillTitle": "Perfekt",
      "beats": [
        { "read": "Eine Woche später. Ayisha ist wieder gesund. Am Montag ruft sie Umma an." },
        { "speaker": "Umma", "play": "Was hast du am Wochenende gemacht?", "tags": "X V.du S.du P O.n.dat V" },
        { "speaker": "Ayisha", "play": "Wir haben einen Ausflug gemacht.", "tags": "S.wir V.wir O.m.akk O.m.akk V" },
        { "speaker": "Ayisha", "play": "Wir sind auf die Schwäbische Alb gefahren.", "tags": "S.wir V.wir P O.f.akk O.f.akk O.f.akk V" },
        { "speaker": "Umma", "play": "Wer ist mitgekommen?", "tags": "X V.er V" },
        { "speaker": "Ayisha", "play": "Lea und Max sind mitgekommen.", "tags": "S.f K S.m V.sie_pl V" },
        { "speaker": "Ayisha", "read": "Und die Leute aus der Cricket-Gruppe. Und … Faris." },
        { "read": "Umma sagt nichts. Aber ihre Augenbrauen sagen sehr viel." },
        { "speaker": "Umma", "play": "Wer ist Faris?", "tags": "X V.er S.m" },
        { "speaker": "Ayisha", "play": "Er kommt auch aus Kerala.", "tags": "S.m V.er X P O.n.dat" },
        { "speaker": "Ayisha", "read": "Er ist Softwareentwickler. Er spielt Badminton. Und er spielt sehr schlecht Cricket." },
        { "speaker": "Ayisha", "play": "Wir haben eine Burg besucht.", "tags": "S.wir V.wir O.f.akk O.f.akk V" },
        { "speaker": "Ayisha", "read": "Die Burg Hohenzollern, Umma! Ganz oben auf einem Berg. Die Bäume waren rot und gold." },
        { "speaker": "Ayisha", "play": "Ich habe viele Fotos gemacht.", "tags": "S.ich V.ich O.pl.akk O.pl.akk V" },
        { "speaker": "Ayisha", "play": "Ich war so glücklich!", "tags": "S.ich V.ich X X" },
        { "speaker": "Umma", "play": "Hast du etwas gegessen?", "tags": "V.du S.du O.n.akk V" },
        { "speaker": "Ayisha", "play": "Max hat Brezeln mitgebracht.", "tags": "S.m V.er O.pl.akk V" },
        { "speaker": "Ayisha", "read": "Und Faris hat Biryani mitgebracht. Von seiner Tante aus Esslingen." },
        { "speaker": "Umma", "play": "Wie war das Biryani?", "tags": "X V.es S.n S.n" },
        { "read": "Ayisha denkt lange nach. Sehr lange." },
        { "speaker": "Ayisha", "play": "Es war nicht schlecht.", "tags": "S.n V.es X X" },
        { "speaker": "Ayisha", "read": "Sechs von zehn. Na gut … sieben." },
        { "read": "Umma lacht laut. Sieben? Von Ayisha? Das hat sie noch nie gehört." },
        { "read": "Am Abend nimmt Ayisha das alte Foto. Sie liest den Satz noch einmal: „Hier habe ich ein Zuhause.“" },
        { "read": "Sie schaut aus dem Fenster. Unten im Garten schlafen die Hühner. Die Lichter von Stuttgart leuchten." },
        { "read": "Vielleicht, denkt sie. Vielleicht bald auch für mich." },
        { "read": "Ende von A1. Fortsetzung folgt …" }
      ],
      "drill": [
        { "play": "Ich habe Tee getrunken.", "tags": "S.ich V.ich O.m.akk V" },
        { "play": "Du hast lange geschlafen.", "tags": "S.du V.du X V" },
        { "play": "Lea hat eine Prüfung gemacht.", "tags": "S.f V.sie O.f.akk O.f.akk V" },
        { "play": "Wir sind nach Ulm gefahren.", "tags": "S.wir V.wir P O.n.dat V" },
        { "play": "Max hat Brot gebacken.", "tags": "S.m V.er O.n.akk V" },
        { "play": "Habt ihr den Berg gesehen?", "tags": "V.ihr S.ihr O.m.akk O.m.akk V" },
        { "play": "Ayisha ist zu Hause geblieben.", "tags": "S.f V.sie P O.n.dat V" },
        { "play": "Ich war gestern müde.", "tags": "S.ich V.ich X X" }
      ]
    }
